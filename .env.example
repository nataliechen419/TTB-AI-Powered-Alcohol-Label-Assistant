# Copy this file to .env and fill in a real key to enable live Claude label
# extraction. .env is gitignored — it will never be committed.
#
# Without this set, the app runs in mock mode automatically: fully demoable,
# zero API cost. See server/mock.ts.
ANTHROPIC_API_KEY=

# Optional: force mock mode on/off regardless of whether a key is present.
# MOCK_MODE=true
